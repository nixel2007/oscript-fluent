#Использовать asserts
#Использовать ".."

Процедура ПереприсвоитьЭлемент(Элемент) Экспорт
	Элемент = 0;
КонецПроцедуры

Функция ОтобратьНечетныйИПереприсвоитьЭлемент(Элемент) Экспорт
	Результат = Элемент % 2 = 1;
	Элемент = 0;
	Возврат Результат;
КонецФункции

Функция СравнитьРавенствоИПереприсвоитьЭлементы(Первый, Второй) Экспорт
	Результат = Первый = Второй;
	Первый = 0;
	Второй = 0;
	Возврат Результат;
КонецФункции

Функция СравнитьИПереприсвоитьЭлементы(Первый, Второй) Экспорт
	Результат = Первый - Второй;
	Первый = 0;
	Второй = 0;
	Возврат Результат;
КонецФункции

Процедура ПроверитьПовторныеОбходы(Процессор, ОжидаемаяСтрока)
	Ожидаем.Что(Процессор.ВСтроку(",")).Равно(ОжидаемаяСтрока);
	Ожидаем.Что(Процессор.ВСтроку(",")).Равно(ОжидаемаяСтрока);
КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьЭлементыПослеДляКаждого_Лямбда() Экспорт
	Процессор = ПроцессорыКоллекций.ИзНабора(1, 2, 3);
	Процессор.ДляКаждого("Элемент -> Элемент = 0");
	ПроверитьПовторныеОбходы(Процессор, "1,2,3");
КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьЭлементыПослеДляКаждого_Действие() Экспорт
	Процессор = ПроцессорыКоллекций.ИзНабора(1, 2, 3);
	Процессор.ДляКаждого(Новый Действие(ЭтотОбъект, "ПереприсвоитьЭлемент"));
	ПроверитьПовторныеОбходы(Процессор, "1,2,3");
КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьРезультатКонвейераПослеДляКаждого() Экспорт
	Процессор = ПроцессорыКоллекций.ИзНабора(1, 2, 3, 4);
	Процессор.Фильтровать("Элемент -> Элемент % 2 = 0")
		.Обработать("Элемент -> Элемент * 10")
		.ДляКаждого("Элемент -> Элемент = 0");
	ПроверитьПовторныеОбходы(Процессор, "20,40");
КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьИзмененияОбъектаБезПодменыЭлемента() Экспорт
	Элемент = Новый Структура("Значение", 1);
	Процессор = ПроцессорыКоллекций.ИзНабора(Элемент);
	Процессор.ДляКаждого("Элемент -> Элемент.Значение = 2; Элемент = Неопределено");
	Для Обход = 1 По 2 Цикл
		Результат = Процессор.ВМассив();
		Ожидаем.Что(Результат[0]).Равно(Элемент);
		Ожидаем.Что(Результат[0].Значение).Равно(2);
	КонецЦикла;
КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьЭлементыПослеФильтрации_Лямбда() Экспорт
	Процессор = ПроцессорыКоллекций.ИзНабора(1, 2, 3);
	Процессор.Фильтровать("Элемент ->
		|Результат = Элемент % 2 = 1;
		|Элемент = 0;
		|Возврат Результат;");
	ПроверитьПовторныеОбходы(Процессор, "1,3");
КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьЭлементыПослеФильтрации_Действие() Экспорт
	Процессор = ПроцессорыКоллекций.ИзНабора(1, 2, 3);
	Процессор.Фильтровать(Новый Действие(ЭтотОбъект, "ОтобратьНечетныйИПереприсвоитьЭлемент"));
	ПроверитьПовторныеОбходы(Процессор, "1,3");
КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьРазличныеЭлементы_Лямбда() Экспорт
	Процессор = ПроцессорыКоллекций.ИзНабора(1, 2, 1, 2, 3);
	Процессор.Различные("Первый, Второй ->
		|Результат = Первый = Второй;
		|Первый = 0;
		|Второй = 0;
		|Возврат Результат;");
	ПроверитьПовторныеОбходы(Процессор, "1,2,3");
КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьРазличныеЭлементы_Действие() Экспорт
	Процессор = ПроцессорыКоллекций.ИзНабора(1, 2, 1, 2, 3);
	Процессор.Различные(Новый Действие(ЭтотОбъект, "СравнитьРавенствоИПереприсвоитьЭлементы"));
	ПроверитьПовторныеОбходы(Процессор, "1,2,3");
КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьЭлементыПослеСортировки_Лямбда() Экспорт
	Процессор = ПроцессорыКоллекций.ИзНабора(3, 1, 2);
	Процессор.Сортировать("Первый, Второй ->
		|Результат = Первый - Второй;
		|Первый = 0;
		|Второй = 0;
		|Возврат Результат;");
	ПроверитьПовторныеОбходы(Процессор, "1,2,3");
КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьЭлементыПослеСортировки_Действие() Экспорт
	Процессор = ПроцессорыКоллекций.ИзНабора(3, 1, 2);
	Процессор.Сортировать(Новый Действие(ЭтотОбъект, "СравнитьИПереприсвоитьЭлементы"));
	ПроверитьПовторныеОбходы(Процессор, "1,2,3");
КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьПоляСтруктурПослеСортировкиПоПолю() Экспорт
	Первый = Новый Структура("Значение", 3);
	Второй = Новый Структура("Значение", 1);
	Третий = Новый Структура("Значение", 2);
	Процессор = ПроцессорыКоллекций.ИзНабора(Первый, Второй, Третий);
	Процессор.СортироватьПо("Значение", "Первый, Второй ->
		|Результат = Первый - Второй;
		|Первый = 0;
		|Второй = 0;
		|Возврат Результат;");
	Для Обход = 1 По 2 Цикл
		Результат = Процессор.ВМассив();
		Ожидаем.Что(Результат[0]).Равно(Второй);
		Ожидаем.Что(Результат[1]).Равно(Третий);
		Ожидаем.Что(Результат[2]).Равно(Первый);
		Ожидаем.Что(Первый.Значение).Равно(3);
		Ожидаем.Что(Второй.Значение).Равно(1);
		Ожидаем.Что(Третий.Значение).Равно(2);
	КонецЦикла;
КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьПоляТаблицыПослеСортировкиПоПолю() Экспорт
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Значение");
	Таблица.Добавить().Значение = 3;
	Таблица.Добавить().Значение = 1;
	Таблица.Добавить().Значение = 2;
	Процессор = ПроцессорыКоллекций.ИзКоллекции(Таблица);
	Процессор.СортироватьПо("Значение", Новый Действие(ЭтотОбъект, "СравнитьИПереприсвоитьЭлементы"));
	Результат = Процессор.ВМассив();
	Ожидаем.Что(Результат[0].Значение).Равно(1);
	Ожидаем.Что(Результат[1].Значение).Равно(2);
	Ожидаем.Что(Результат[2].Значение).Равно(3);
	Ожидаем.Что(Таблица[0].Значение).Равно(3);
	Ожидаем.Что(Таблица[1].Значение).Равно(1);
	Ожидаем.Что(Таблица[2].Значение).Равно(2);
КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиМинимумБезПодменыЭлементов() Экспорт
	Процессор = ПроцессорыКоллекций.ИзНабора(3, 1, 2);
	Результат = Процессор.Минимум(Новый Действие(ЭтотОбъект, "СравнитьИПереприсвоитьЭлементы"));
	Ожидаем.Что(Результат).Равно(1);
	ПроверитьПовторныеОбходы(Процессор, "1,2,3");
КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиМаксимумБезПодменыЭлементов() Экспорт
