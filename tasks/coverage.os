#Использовать coverage
#Использовать 1commands
#Использовать fs

СистемнаяИнформация = Новый СистемнаяИнформация;
ЭтоWindows = Найти(НРег(СистемнаяИнформация.ВерсияОС), "windows") > 0;

ПутьКОтчетам = "out";
ФС.ОбеспечитьПустойКаталог(ПутьКОтчетам);
ПутьКСтат = ОбъединитьПути(ПутьКОтчетам, "stat.json");

Команда = Новый Команда;
Команда.УстановитьКоманду("oscript");
Если НЕ ЭтоWindows Тогда
	Команда.ДобавитьПараметр("-encoding=utf-8");
КонецЕсли;
Команда.ДобавитьПараметр(СтрШаблон("-codestat=%1", ПутьКСтат));
Команда.ДобавитьПараметр(ОбъединитьПути("tasks", "test.os"));
Команда.ПоказыватьВыводНемедленно(Истина);

КодВозврата = Команда.Исполнить();

ПроцессорГенерации = Новый ГенераторОтчетаПокрытия();

ПроцессорГенерации.ОтносительныеПути()
	.РабочийКаталог(ПутьКОтчетам)
	.КаталогИсходников(ТекущийКаталог())
	.ИмяФайлаСтатистики()
	.GenericCoverage()
	.Cobertura()
	.Сформировать();

КопироватьФайл(
	ОбъединитьПути("build", "testsResults", "tests.xml"),
	ОбъединитьПути(ПутьКОтчетам, "genericExecution.xml")
);

ЗавершитьРаботу(КодВозврата);
