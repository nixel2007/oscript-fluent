&Тест
Процедура ТестДолжен_ЗаменитьЭлементыРезультатомОбработки() Экспорт
	Процессор = ПроцессорыКоллекций.ИзНабора(1, 2, 3);
	Процессор.Обработать("Элемент -> Результат = Элемент * 10; Элемент = 0; Возврат Результат;");
	ПроверитьПовторныеОбходы(Процессор, "10,20,30");
КонецПроцедуры

&Тест
Процедура ТестДолжен_СократитьБезПодменыЭлементов() Экспорт
	Процессор = ПроцессорыКоллекций.ИзНабора(1, 2, 3);
	Результат = Процессор.Сократить("Сумма, Элемент ->
		|Результат = Сумма + Элемент;
		|Сумма = 0;
		|Элемент = 0;
		|Возврат Результат;", 0);
	Ожидаем.Что(Результат).Равно(6);
	ПроверитьПовторныеОбходы(Процессор, "1,2,3");
КонецПроцедуры

&Тест
Процедура ТестДолжен_РазвернутьБезПодменыЭлементов() Экспорт
	Процессор = ПроцессорыКоллекций.ИзНабора(1, 2, 3);
	Процессор.Развернуть("Элемент ->
		|Результат = ПроцессорыКоллекций.ИзНабора(Элемент, Элемент * 10);
		|Элемент = 0;
		|Возврат Результат;");
	ПроверитьПовторныеОбходы(Процессор, "1,10,2,20,3,30");
КонецПроцедуры
